{
	"name": "express-rate-limit",
	"version": "8.6.2",
	"description": "Basic IP rate-limiting middleware for Express. Use to limit repeated requests to public APIs and/or endpoints such as password reset.",
	"author": {
		"name": "Nathan Friedly",
		"url": "http://nfriedly.com/"
	},
	"license": "MIT",
	"homepage": "https://github.com/express-rate-limit/express-rate-limit",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/express-rate-limit/express-rate-limit.git"
	},
	"funding": "https://github.com/sponsors/express-rate-limit",
	"keywords": [
		"express-rate-limit",
		"express",
		"rate",
		"limit",
		"ratelimit",
		"rate-limit",
		"middleware",
		"ip",
		"auth",
		"authorization",
		"security",
		"brute",
		"force",
		"bruteforce",
		"brute-force",
		"attack"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist/",
		"tsconfig.json"
	],
	"engines": {
		"node": ">= 16"
	},
	"scripts": {
		"clean": "del-cli dist/ coverage/ *.log *.tmp *.bak *.tgz",
		"build": "tsdown",
		"compile": "run-s clean build",
		"docs": "cd docs && mintlify dev",
		"lint:code": "biome check",
		"lint:docs": "prettier --check docs/ *.md",
		"lint": "run-s lint:*",
		"format:code": "biome check --write",
		"format:docs": "prettier --write docs/ *.md",
		"format": "run-s format:*",
		"test:library": "vitest run --project library:*",
		"test:stores": "vitest run --project stores:* --coverage.enabled=false",
		"test:package": "attw --pack . && publint",
		"test": "run-s lint test:library",
		"pre-commit": "lint-staged",
		"prepare": "run-s compile && husky"
	},
	"dependencies": {
		"debug": "^4.4.3",
		"ip-address": "^10.2.0"
	},
	"peerDependencies": {
		"express": ">= 4.11"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@asyncapi/specs": "6.11.1",
		"@biomejs/biome": "2.4.6",
		"@express-rate-limit/prettier": "1.1.1",
		"@express-rate-limit/tsconfig": "1.0.5",
		"@nestjs/common": "11.2.3",
		"@types/debug": "4.1.13",
		"@types/express": "5.0.6",
		"@types/node": "26.2.0",
		"@types/supertest": "7.2.1",
		"@vitest/coverage-v8": "4.1.11",
		"del-cli": "7.0.0",
		"express": "5.2.1",
		"express4": "npm:express@4.22.0",
		"husky": "9.1.7",
		"lint-staged": "17.3.0",
		"mintlify": "4.2.817",
		"npm-run-all": "4.1.5",
		"pino-http": "11.0.0",
		"precise-memory-rate-limit": "2.0.1",
		"prettier": "3.9.6",
		"publint": "0.3.24",
		"rate-limit-memcached": "1.0.1",
		"rate-limit-mongo": "2.3.2",
		"rate-limit-redis": "6.0.1",
		"ratelimit-header-parser": "0.1.0",
		"redis": "6.2.1",
		"supertest": "7.2.2",
		"testcontainers": "12.1.0",
		"ts-node": "10.9.2",
		"tsdown": "0.22.14",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"prettier": "@express-rate-limit/prettier",
	"lint-staged": {
		"*.{js,ts,json}": "biome check --write",
		"*.{md,yaml}": "prettier --write"
	}
}
